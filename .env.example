# Phil settings. Copy this file to ".env" and replace the placeholder values.
# The real ".env" is ignored by git, so your key stays private.

# --- Model (any OpenAI-compatible API) --------------------------------------
API_KEY=your-key-here
API_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Optional: use different models for planning and for step-by-step decisions.
# Both fall back to MODEL_NAME when left empty.
PLANNER_MODEL_NAME=
AGENT_MODEL_NAME=

# Ask the API for JSON-only replies. Set to false if your provider rejects it.
JSON_MODE=true
# Leave empty to use the provider default (some models reject custom values).
TEMPERATURE=
REQUEST_TIMEOUT=60
MAX_RETRIES=2

# --- Phone -------------------------------------------------------------------
# Leave empty when exactly one phone is connected. Otherwise e.g. R58M123ABC
# or 192.168.1.20:5555 (see: python main.py --list-devices).
DEVICE_SERIAL=
ADB_PATH=adb
# true = fast uiautomator2 reader, false = plain "adb uiautomator dump" only.
USE_UIAUTOMATOR2=true
# Comma-separated packages hidden from the model. "none" shows everything
# (including the notification shade).
IGNORED_PACKAGES=com.android.systemui

# --- Agent behaviour ---------------------------------------------------------
MAX_STEPS=30
# Seconds to wait after each action so animations can finish (0.7 - 1.5 works well).
STABILIZE_DELAY=1.0
# Ask you before risky actions (send, pay, delete...) and when the model asks.
CONFIRM_RISKY=true
# Send the whole UI tree every step instead of only the changes.
ALWAYS_SEND_FULL_TREE=false
# Below this fraction of shared elements, the screen counts as a new screen.
OVERLAP_THRESHOLD=0.4
# Same action repeated more than this many times with no change = stuck.
STUCK_THRESHOLD=4

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Optional file for a persistent log, e.g. phil.log
LOG_FILE=
